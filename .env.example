# PhysiqueLapse server settings. Copy to .env (never committed) and edit.

# Your time zone. The app stores dates in local time; containers default to UTC.
TZ=Etc/UTC

# Where your library lives on the host (photos, database, models). Back this folder up.
# Must be owned by PUID:PGID (`id` shows yours): sudo chown -R 1000:1000 /srv/physiquelapse
PL_DATA_PATH=/srv/physiquelapse/data
PUID=1000
PGID=1000

# Host port, published on 127.0.0.1 only. tailscale serve points at it.
PL_PORT=8420

# Resource caps, so heavy jobs leave room for other apps on the machine.
PL_CPUS=5          # CPU cores the container may use
PL_MEM=8g          # memory limit
PL_THREADS=4       # threads per model library (torch / OpenCV)
PL_CV_WORKERS=1    # model jobs running at once (1-2)
PL_JOB_NICE=10     # job threads run at lower CPU priority (0-19)

# Login
PL_SESSION_DAYS=30
PL_COOKIE_SECURE=true   # keep true behind tailscale serve (HTTPS)
# Extra origins allowed to send changes, comma-separated (normally empty)
PL_ALLOWED_ORIGINS=
